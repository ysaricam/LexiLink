# Build artifacts — must be excluded so the SDK restores/builds cleanly inside
# the image and so iCloud "* 2.sql" duplicates that accumulate under bin/ never
# reach the build context (they would break DbUp with "duplicate script").
**/bin/
**/obj/
**/*.user
**/*.suo

# The Flutter app is not built or served by the server (mobile-only via stores).
frontend/

# Docs, git, CI, scripts, IDE, local tooling — irrelevant to the runtime image.
docs/
.git/
.github/
.vs/
.idea/
.vscode/
scripts/

# Compose/deploy artifacts and local secrets — never bake into the image.
docker-compose*.yml
Caddyfile
.env
.env.*
!.env.example

# OS cruft and iCloud duplicates anywhere in the tree.
.DS_Store
**/.DS_Store
**/* 2.*
**/*.lscache
