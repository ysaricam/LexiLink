# LexiLink production environment — copy to .env and fill in real values.
#
#   cp .env.example .env   (on the server: /opt/lexilink/.env, root-only: chmod 600)
#
# NEVER commit the real .env. Every CHANGE_ME below must be replaced.

# ---- Domain / TLS (Caddy) -------------------------------------------------
# Caddy serves the public site at https://<LEXILINK_DOMAIN>, the API at
# https://api.<LEXILINK_DOMAIN>, and the browser admin panel at
# https://admin.<LEXILINK_DOMAIN>. A real, DNS-resolvable domain is REQUIRED
# (no certificate is issued for a bare IP). Point A records for the apex
# domain, api.<domain>, and admin.<domain> at the server before bringing
# Caddy up.
LEXILINK_DOMAIN=example.com
LEXILINK_ACME_EMAIL=ops@example.com
# Static public pages mounted into Caddy at https://<LEXILINK_DOMAIN>.
PUBLIC_WEB_ROOT=./public-site
# Static Flutter web admin build mounted into Caddy.
ADMIN_WEB_ROOT=./frontend/build/web

# ---- Container image ------------------------------------------------------
# Local build tag by default. GO6 (CI/CD) sets this to the GHCR image, e.g.
# ghcr.io/<owner>/lexilink:<tag>, so the server pulls instead of building.
LEXILINK_IMAGE=lexilink:local

# ---- PostgreSQL (container) ----------------------------------------------
POSTGRES_DB=lexilink
POSTGRES_USER=lexilink
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password

# ---- API: database connection -------------------------------------------
# Host MUST be the compose service name 'postgres'. Database/Username/Password
# MUST match the POSTGRES_* values above.
ConnectionStrings__LexiLinkDb=Host=postgres;Port=5432;Database=lexilink;Username=lexilink;Password=CHANGE_ME_use_a_long_random_password

# ---- API: runtime + authentication (ProductionJwt) -----------------------
ASPNETCORE_ENVIRONMENT=Production
Authentication__Mode=ProductionJwt
Authentication__Jwt__Issuer=LexiLink
Authentication__Jwt__Audience=LexiLink.Api
# At least 32 characters. Generate a strong random secret (e.g. `openssl rand -base64 48`).
Authentication__Jwt__SigningKey=CHANGE_ME_at_least_32_characters_long_random_secret
Authentication__Jwt__AccessTokenLifetimeMinutes=60
# Guest-first login (GO-A). 'Disabled' would 401 every player. 'GuestDevice'
# enables the guest flow; Apple/Google are rejected until real social sign-in
# is wired (a planned follow-up).
Authentication__TokenExchange__Mode=GuestDevice
# Browser admin console login (POST /auth/admin/token). Disabled returns 401.
# AdminSharedSecret accepts the External token entered on /admin/login only
# when it matches this server-side secret; the email must still be an active
# bootstrapped admin. Generate with `openssl rand -base64 48`.
Authentication__AdminTokenExchange__Mode=AdminSharedSecret
Authentication__AdminTokenExchange__SharedSecret=CHANGE_ME_at_least_32_characters_long_random_admin_secret

# ---- Administration: bootstrap admin(s) ----------------------------------
# Indexed array. Each email is ensured as an Admin on every API start (idempotent).
Administration__Bootstrap__AdminEmails__0=CHANGE_ME_you@example.com

# ---- CORS -----------------------------------------------------------------
# Native mobile clients don't enforce CORS. Browser admin builds do: list the
# exact admin frontend origin(s) here when serving it from a separate host.
# Local example: Cors__AllowedOrigins__0=http://localhost:8080
Cors__AllowedOrigins__0=https://admin.example.com
