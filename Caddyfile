# LexiLink reverse proxy — API + browser admin console.
# Domain + ACME email are injected from the environment by the caddy service
# (see docker-compose.yml / .env). Caddy obtains and renews a Let's Encrypt
# certificate automatically; a real, DNS-resolvable domain is required.

{
	email {$LEXILINK_ACME_EMAIL}
}

api.{$LEXILINK_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

admin.{$LEXILINK_DOMAIN} {
	encode zstd gzip
	root * /srv/admin

	header /index.html Cache-Control "no-cache"
	header /flutter_service_worker.js Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
